{
  "name": "bechtel-assessment",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "db:seed": "npm run db:seed --workspace=server --",
    "db:reset": "npm run db:reset --workspace=server --",
    "admin:create": "npm run admin:create --workspace=server",
    "admin:list": "npm run admin:list --workspace=server",
    "roster:seed": "npm run roster:seed --workspace=server",
    "roster:list": "npm run roster:list --workspace=server",
    "roster:admin": "npm run roster:admin --workspace=server --",
    "roster:revoke": "npm run roster:revoke --workspace=server --",
    "roster:passwords": "npm run roster:passwords --workspace=server --"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
